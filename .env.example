# SwitcherHub backend — environment example
# Copy to `.env` and fill real values. Do NOT commit real secrets.

# ── Feature flags (value-first rework, spec 001) ──────────────────────────────
# DEMO_MODE: when true, faker-based mock/seed data MAY be served.
# MUST be false in production (constitution: Truthful Data — no synthetic people/counters).
DEMO_MODE=false
# BILLING_ENABLED: decoupled from worker registration; stays false until a
# versioned billing policy is chosen. HR approval is never gated on payment.
BILLING_ENABLED=false

# ── Deployment ────────────────────────────────────────────────────────────────
DEPLOYMENT_MODE=dev            # 'prod' enables production DB/SSL behavior
API_PORT=3000
FRONTEND_URL=http://localhost:3001
FILE_BASE_URL=
DEFAULT_PAGE_SIZE=20

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=switcherhub

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=
RECOVERY_CODE_EXPIRES_IN=10        # minutes
REGISTER_CODE_EXPIRES_IN=1         # days

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_REGISTRATION_LINK=

# ── OAuth (Google / Apple) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_LOCATION=

# ── Routing / Maps ────────────────────────────────────────────────────────────
ROUTING_PROVIDER=osrm              # osrm | mapbox | tomtom
MAP_URL=https://map.switcherhub.com
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=
ROUTING_CACHE_ENABLED=true
ROUTING_FALLBACK_AVERAGE_SPEED_KMH=40
ROUTING_FALLBACK_DISTANCE_COEFFICIENT=1.3

# ── Push (OneSignal) ──────────────────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── Stripe (only used when BILLING_ENABLED=true) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
