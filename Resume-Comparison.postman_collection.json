            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "[]"
        },
        {
          "name": "Resume Not Found",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/resume-comparison/:resumeId/calculate?radius=10",
              "host": ["{{base_url}}"],
              "path": ["resume-comparison", ":resumeId", "calculate"],
              "query": [
                {
