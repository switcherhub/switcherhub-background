                }
              ]
            }
          },
          "status": "Not Found",
          "code": 404,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Resume with id {resumeId} not found\",\n  \"error\": \"Not Found\"\n}"
        }
      ]
    },
