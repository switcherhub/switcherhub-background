{
  "name": "switcherhub-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "npm run build && cp .env dist/.env && node --trace-gc --max-old-space-size=2048 dist/main.js",
    "prod": "npm run build && cp .env dist/.env && pm2 restart all",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed-default-data.ts",
    "seed:scoring": "ts-node -r tsconfig-paths/register src/scripts/seed-scoring-configuration.ts",
    "seed:score-percentages": "ts-node -r tsconfig-paths/register src/scripts/seed-score-percentages.ts",
    "delete:resumes": "ts-node -r tsconfig-paths/register src/scripts/delete-all-resumes.ts",
    "generate:test-resumes": "ts-node -r tsconfig-paths/register src/scripts/generate-test-resumes.ts",
    "generate:filtered-resumes": "ts-node -r tsconfig-paths/register src/scripts/generate-filtered-resumes.ts",
    "backfill:job-type": "ts-node -r tsconfig-paths/register src/scripts/backfill-resume-job-type.ts",
    "backfill:swap-score-comparison": "ts-node -r tsconfig-paths/register src/scripts/backfill-swap-score-comparison.ts",
    "backfill:swap-request-chats": "ts-node -r tsconfig-paths/register src/scripts/backfill-swap-request-chats.ts",
    "recalculate:commute": "ts-node -r tsconfig-paths/register src/scripts/recalculate-commute.ts",
    "clear:cache": "ts-node -r tsconfig-paths/register src/scripts/clear-redis-cache.ts",
    "view:routing-errors": "ts-node -r tsconfig-paths/register src/scripts/view-routing-errors.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.5.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.2",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^11.1.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^11.1.3",
    "@types/passport-local": "^1.0.38",
    "apple-signin-auth": "^1.7.8",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cache-manager": "^6.4.3",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "geojson": "^0.5.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.6.1",
    "jwks-rsa": "^3.1.0",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stripe": "^14.25.0",
    "typeorm-dynamic-filters": "^0.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
